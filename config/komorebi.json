{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 8,
  "default_container_padding": 4,
  "border": true,
  "border_width": 2,
  "border_offset": -1,
  "border_implementation": "Komorebi",
  "border_colours": {
    "single": "#b4befe",
    "stack": "#a6e3a1",
    "monocle": "#cba6f7",
    "floating": "#f9e2af",
    "unfocused": "#45475a"
  },
  "animation": { "enabled": true, "duration": 180, "fps": 120, "style": "EaseInOutSine" },
  "mouse_follows_focus": false,
  "focus_follows_mouse": "Windows",
  "ignore_rules": [
    { "kind": "Exe", "id": "Flow.Launcher.exe", "matching_strategy": "Equals" },
    { "kind": "Title", "id": "Wallpaper Picker", "matching_strategy": "Equals" }
  ],
  "monitors": [{
    "workspaces": [
      { "name": "1", "layout": "BSP" },
      { "name": "2", "layout": "BSP" },
      { "name": "3", "layout": "BSP" },
      { "name": "4", "layout": "BSP" },
      { "name": "5", "layout": "BSP" },
      { "name": "6", "layout": "BSP" },
      { "name": "7", "layout": "BSP" },
      { "name": "8", "layout": "BSP" },
      { "name": "9", "layout": "BSP" },
      { "name": "10", "layout": "BSP" }
    ]
  }]
}
